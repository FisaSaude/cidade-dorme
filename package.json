{
  "name": "cidade-dorme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "json-server --watch db.json --port 3001 --middlewares ./json-server.middleware.cjs",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "json-server": "^0.17.4",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
